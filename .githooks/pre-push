#!/bin/sh
#
# Запрет отправки чего бы то ни было в репозиторий апстрима.
#
# Главная защита не здесь, а в том, ЧЕМ является наш репозиторий на GitHub:
# он создан самостоятельным (`gh repo create`), а не форком velxio. GitHub
# разрешает pull request только между репозиториями одной сети форков, так
# что открыть PR в davidmonterocrespo24/velxio из нашего нельзя вовсе —
# такой кнопки просто нет. Проверить это можно так:
#
#   gh repo view IT-Arduino/it-arduino-sim --json isFork,parent
#
# Ответ обязан быть {"isFork":false,"parent":null}. Если там окажется
# velxio — значит репозиторий создали кнопкой Fork, и защиты нет: сеть
# форков разъединяется только через поддержку GitHub либо удалением и
# пересозданием репозитория.
#
# Этот хук закрывает вторую дверь — локальную. Remote `upstream` подключён
# на чтение, и его push-адрес заменён на несуществующий, но:
#   - подменённый адрес живёт в .git/config и не переживает свежий клон;
#   - `git push https://github.com/davidmonterocrespo24/velxio.git ...`
#     работает по прямому адресу, минуя настройки remote;
#   - `git remote set-url` возвращает рабочий адрес одной строкой.
# Хук срабатывает на всех трёх путях, потому что смотрит на адрес, который
# git реально собрался использовать.
#
# Включается один раз на рабочую копию (git намеренно не включает хуки из
# клона сам — иначе клонирование чужого репозитория запускало бы чужой код):
#
#   git config core.hooksPath .githooks
#
# Аргументы от git: $1 — имя remote, $2 — его URL.

remote_name="$1"
remote_url="$2"

case "$remote_url" in
  *velxio*|*davidmonterocrespo24*)
    echo "" >&2
    echo "ОТКАЗ: отправка в репозиторий апстрима запрещена." >&2
    echo "" >&2
    echo "  remote: $remote_name" >&2
    echo "  адрес:  $remote_url" >&2
    echo "" >&2
    echo "Апстрим подключён только на чтение. Обновления берутся так:" >&2
    echo "  git fetch upstream && git merge upstream/master" >&2
    echo "" >&2
    echo "Наш репозиторий — https://github.com/IT-Arduino/it-arduino-sim" >&2
    echo "" >&2
    exit 1
    ;;
esac

exit 0
