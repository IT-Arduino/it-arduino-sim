#!/bin/sh
#
# Проверка сообщения коммита на неразвернувшуюся команду оболочки.
#
# Повод конкретный. Команда вида
#
#   git commit --amend -m "$(git log -1 --pretty=%B | sed '/^Co-Authored/d')"
#
# написана под Git Bash. В PowerShell `sed` нет вовсе, подстановка не
# срабатывает, и в сообщение коммита попадает сам текст команды. Коммит при
# этом проходит молча — git не знает, что автор имел в виду что-то другое,
# и ошибка обнаруживается уже на GitHub.
#
# Хук ловит именно этот класс: заголовок, который выглядит как невыполненная
# подстановка оболочки. Проверяется только заголовок, потому что упоминание
# `$(...)` в теле сообщения — законная вещь (цитата команды в описании
# правки), а вот заголовок из неё не состоит никогда.
#
# Аргумент от git: $1 — путь к файлу с сообщением.

msg_file="$1"

# Заголовок: первая строка, не пустая и не комментарий.
subject=$(grep -v '^#' "$msg_file" | grep -v '^[[:space:]]*$' | head -1)

case "$subject" in
  '$('*|'`'*|'${'*)
    echo "" >&2
    echo "ОТКАЗ: заголовок коммита выглядит как невыполненная команда оболочки." >&2
    echo "" >&2
    echo "  $subject" >&2
    echo "" >&2
    echo "Похоже, команда с \$(...) написана под Git Bash, а выполнена в" >&2
    echo "PowerShell. Надёжный способ, одинаковый в обеих оболочках:" >&2
    echo "  git commit --amend -F <файл-с-сообщением>" >&2
    echo "" >&2
    exit 1
    ;;
esac

# Пустой заголовок — тоже почти всегда следствие сорвавшейся подстановки.
if [ -z "$subject" ]; then
  echo "" >&2
  echo "ОТКАЗ: сообщение коммита пустое." >&2
  echo "" >&2
  exit 1
fi

exit 0
